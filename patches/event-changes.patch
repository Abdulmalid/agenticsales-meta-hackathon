+    def _photo_references(self) -> tuple[list[tuple[str, bytes]], dict[str, list[str]]]:
+        """What the model may compare a customer's photo with: the first photo of up to six active products (about 3 MB in all), and the colours
+        or sizes the shop stocks. A shop with no photos just gets name matching, as before."""
+        from ..vision.reader import MAX_REFERENCE_BYTES, MAX_REFERENCES
+
+        refs, used = [], 0
+        for p in self.cfg.products:
+            if len(refs) >= MAX_REFERENCES:
+                break
+            path = self.content.product_image(p.sku) if (p.in_stock and self.content is not None) else None
+            if path is None or path.stat().st_size + used > MAX_REFERENCE_BYTES:
+                continue
+            refs.append((p.sku, path.read_bytes()))
+            used += path.stat().st_size
+        colours = {p.sku: list(self.inventory.info(p.sku).variants) for p in self.cfg.products if p.in_stock}
