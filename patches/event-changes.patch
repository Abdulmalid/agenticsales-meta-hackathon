+
+    def _inspect_receipt(self, reading, msg: InboundMessage, trace: str):
+        """The receipt checks on a payment screenshot. The agent tells the customer plainly when a receipt does not hold up and
+        releases nothing on it, so the owner is not asked to act; the findings are in the audit log. Never confirms a payment."""
