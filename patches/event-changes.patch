+        </>
+      )}
+      <form className="grid g2" onSubmit={issue}>
+        <label className="field">Business
+          <select value={tenant} onChange={(e) => setTenant(e.target.value)} required>
+            {tenants.map((t) => <option key={t.id} value={t.id}>{t.business_name}{t.disabled ? " (suspended)" : ""}</option>)}
+          </select>
+        </label>
+        <label className="field">Who is it for?<input value={label} onChange={(e) => setLabel(e.target.value)} maxLength={80} required placeholder="e.g. Ada (owner), Bola (sales)" /></label>
