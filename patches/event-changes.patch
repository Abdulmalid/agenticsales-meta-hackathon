+def _event_kinds(entry: dict) -> dict:
+    """What one webhook entry carries, without any message text: counts of event types (message, echo, read, reaction, ...) and
+    of changed fields. Logged so a message that never arrives can be told apart from one we deliberately skip."""
+    counts: dict[str, int] = {}
+    for ev in entry.get("messaging") or []:
+        for k in ev:
+            if k in ("sender", "recipient", "timestamp"):
+                continue
+            name = "echo" if k == "message" and (ev.get("message") or {}).get("is_echo") else k
+            counts[name] = counts.get(name, 0) + 1
+    for change in entry.get("changes") or []:
+        name = f"change:{change.get('field')}"
+        counts[name] = counts.get(name, 0) + 1
+    return counts
