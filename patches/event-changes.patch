+    def _coalesce(self, msg: InboundMessage) -> InboundMessage | None:
+        """Telegram and other channels cut a very long text into several messages, delivered a moment apart. Answering each part on its own
+        gives a reply to half a thought, so a long message waits briefly for the next part and the parts are answered once, together.
+        Short messages are never delayed. Returns the (merged) message to answer, or None when a later part will carry this one."""
+        import dataclasses
+
+        if len(msg.text) < COALESCE_MIN_CHARS:
+            return msg
+        key = f"{msg.channel.value}:{msg.user_id}"
+        with self._parts_lock:
+            self._parts.setdefault(key, []).append(msg)
+        time.sleep(COALESCE_SECONDS)
+        with self._parts_lock:
+            parts = self._parts.get(key, [])
+            if not parts or parts[-1] is not msg:
+                return None
+            del self._parts[key]
+        if len(parts) == 1:
+            return msg
+        return dataclasses.replace(msg, text="\n\n".join(p.text for p in parts), attachments=tuple(a for p in parts for a in p.attachments))
