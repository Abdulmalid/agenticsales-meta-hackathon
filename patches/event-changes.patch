+        if adapter is None or not hasattr(adapter, "typing"):
+            return
+        try:
+            adapter.typing(msg.user_id, self.secrets.get(msg.channel.value))
+        except Exception:  # noqa: BLE001 - a missing indicator must never stop a customer being answered
+            pass
