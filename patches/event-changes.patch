+    def test_a_key_can_expire_by_itself_and_the_expiry_is_audited(self):
+        from datetime import datetime, timedelta, timezone
+        shop = self.new_shop()
+        r = self.c.post(f"/admin/tenants/{shop['tenant_id']}/keys", headers=self.H(), json={"role": "staff", "label": "Ada", "expires_days": 30})
+        self.assertEqual(r.status_code, 200, r.text)
+        key = r.json()["key"]
+        self.assertEqual(self.c.get("/v1/me", headers=self.H(key)).status_code, 200)
+        row = next(k for k in self.auth.list_keys(shop["tenant_id"]) if k["label"] == "Ada")
+        self.assertGreater(datetime.fromisoformat(row["expires"]), datetime.now(timezone.utc) + timedelta(days=29))
+        with self.auth._con:                                                  # time passes
+            self.auth._con.execute("UPDATE api_keys SET expires=? WHERE id=?", ((datetime.now(timezone.utc) - timedelta(seconds=1)).isoformat(), row["id"]))
+        self.assertEqual(self.c.get("/v1/me", headers=self.H(key)).status_code, 401)
