+test("under the hood lists each step with its engine and timing, and separates Meta model calls from our own code", () => {
+  const ev = (kind: string, rest: Record<string, unknown> = {}) => ({ ts: "t", trace: "x", kind, ...rest });
+  const h = underTheHood([
+    ev("photo_read", { photo: "product", sku: "IP15", model: "muse-spark-1.3", ms: 3100 }),
+    ev("analysis", { source: "llm+rules", register: "pidgin", ms: 2400 }),
+    ev("lead", { stage: "QUALIFIED", score: 16 }),
+    ev("fraud", { risk: "LOW" }),
+    ev("model_plan", { model: "muse-spark-1.3", note: "Quoted the policy price", ms: 6200 }),
+    ev("tool_call", { tool: "quote_price", status: "ok" }),
+    ev("reply_sent", { escalated: false, total_ms: 9100 }),
+  ] as never);
+  assert.deepEqual(h.steps.map((s) => s.key), ["photo", "analysis", "lead", "fraud", "plan", "tool-5", "sent"]);
+  assert.equal(h.steps[0].detail, "Matched catalogue item IP15");
+  assert.equal(h.steps[0].engine, "Muse Spark vision");
+  assert.deepEqual(h.steps.filter((s) => s.meta).map((s) => s.key), ["photo", "analysis", "plan"]);
+  assert.equal(h.metaCalls, 3);
+  assert.equal(h.metaMs, 3100 + 2400 + 6200);
+  assert.equal(h.totalMs, 3100 + 9100);                       // the photo was read before the turn started
+  assert.equal(h.steps.find((s) => s.key === "lead")?.engine, "Our code");
+});
