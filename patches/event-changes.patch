+    def _owner_books(self, msg: InboundMessage, trace: str | None = None) -> TurnResult | None:
+        """The owner, writing from their linked Telegram chat, logging an expense or asking for profit. Everyone else goes on to the sales agent."""
+        if msg.channel.value != "telegram" or not msg.text.strip() or self.alerts.owner_chat() != msg.user_id:
+            return None
+        reply = owner_reply(self.books, msg.text)
+        if reply is None:
+            return None
