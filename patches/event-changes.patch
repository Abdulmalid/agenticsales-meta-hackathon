+test("under the hood copes with rules-only analysis, voice notes, receipts and odd values", () => {
+  const ev = (kind: string, rest: Record<string, unknown> = {}) => ({ ts: "t", trace: "x", kind, ...rest });
+  const h = underTheHood([
+    ev("voice_transcribed", { chars: 42, model: "muse-voice-transcribe-1.0", ms: 4400 }),
+    ev("photo_read", { photo: "payment_receipt", sku: null, ms: "slow" }),
+    ev("analysis", { source: "rules(fallback)", register: "formal", ms: 3 }),
+    ev("model_plan", { model: "gemini-flash", ms: -5 }),
+  ] as never);
+  assert.equal(h.steps[0].engine, "Muse Voice Transcribe");
+  assert.equal(h.steps[1].detail, "Looks like a payment screenshot");
+  assert.equal(h.steps[1].ms, null);
+  assert.equal(h.steps[2].meta, false);
+  assert.equal(h.steps[3].meta, false);                      // not a Meta model
+  assert.equal(h.steps[3].ms, 0);
+  assert.equal(modelLabel(undefined, "AI model"), "AI model");
+  assert.equal(modelLabel("something-new", "x"), "something-new");
+});
