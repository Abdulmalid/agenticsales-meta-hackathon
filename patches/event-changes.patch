+.awayvalue { font-family: var(--display); font-size: 1.7rem; font-weight: 580; line-height: 1.2; font-variant-numeric: tabular-nums; }
+.awayfoot { display: grid; gap: 0.6rem; margin-top: 1rem; padding-top: 0.9rem; border-top: 1px solid var(--line); }
+@media (max-width: 800px) { .awaygrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+
+/* inline icon sitting in a line of text (timelines, trace steps) */
+.ic { display: inline-flex; vertical-align: -0.2em; margin-right: 0.4em; color: var(--muted); }
+.ic svg { width: 1.05em; height: 1.05em; }
+.btn svg { vertical-align: -0.2em; }
