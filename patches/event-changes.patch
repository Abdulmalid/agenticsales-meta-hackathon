+    # -------------------------------------------------------------------------------- TikTok Direct Post
+    def tiktok_publisher(self, levels=("SELF_ONLY",), statuses=("PUBLISH_COMPLETE",), error=None, init_ok=True):
+        from agentic_sales.content import publishers
+        calls, puts = [], []
+        polls = iter(statuses)
+
+        def post(url, headers, body, **kw):
+            name = url.split("/v2/")[1]
+            calls.append((name, body, headers))
+            if error and name == "post/publish/creator_info/query/":
+                return {"error": {"code": error[0], "message": error[1]}}
+            if name == "post/publish/creator_info/query/":
+                return {"data": {"privacy_level_options": list(levels)}, "error": {"code": "ok"}}
+            if name in ("post/publish/video/init/", "post/publish/inbox/video/init/"):
+                return {"data": {"publish_id": "PID1", "upload_url": "https://upload.test/u"} if init_ok else {}, "error": {"code": "ok"}}
+            return {"data": {"status": next(polls, statuses[-1]), "fail_reason": "video_too_long"}, "error": {"code": "ok"}}
+        return publishers.TikTokPublisher(post, lambda url, data, headers: puts.append((url, data, headers)) or 200), calls, puts
+
+    def video_file(self, n=60, name="clip.mp4"):
+        path = Path(tempfile.mkdtemp()) / name
+        path.write_bytes(b"\x00\x00\x00\x18ftypmp42" + b"v" * (n - 12))
+        return path
