+test("a product file is cut into pieces that each carry the heading and keep their place in the file", async () => {
+  const { chunkCsv, splitRecords } = await import("../lib/csv.ts");
+  const rows = Array.from({ length: 5 }, (_, i) => `Item ${i},${1000 + i},3`);
+  const text = ["Product Name,Price,Stock", ...rows].join("\r\n");
+  const out = chunkCsv(text, 10_000, 2);
+  assert.deepEqual(out.map((c) => c.rows), [2, 2, 1]);
+  assert.ok(out.every((c) => c.csv.startsWith("Product Name,Price,Stock\n")));
+  assert.deepEqual(out.map((c) => c.offset), [0, 2, 4]);                  // the 3rd product is on line 4 of the file: offset 2 + 2
+  assert.equal(chunkCsv("", 100, 10).length, 0);
+  assert.deepEqual(splitRecords('a,"x\ny",b\nc,d,e'), ['a,"x\ny",b', "c,d,e"]);   // a line break inside quotes stays in its cell
+  const big = chunkCsv(["Name,Price", ...Array.from({ length: 300 }, (_, i) => `Thing number ${i},${i + 1}`)].join("\n"), 1000, 2000);
+  assert.ok(big.length > 1 && big.every((c) => c.csv.length <= 1000));
+  assert.equal(big.reduce((n, c) => n + c.rows, 0), 300);
+});
